# ============================================
# TenantFlow Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/tenantflow
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET_KEY=REPLACE_THIS_WITH_A_STRONG_512_BIT_SECRET_KEY_GENERATED_BY_OPENSSL
JWT_EXPIRATION=900000
# 15 minutes in milliseconds (15 * 60 * 1000)
JWT_REFRESH_EXPIRATION=604800000
# 7 days in milliseconds (7 * 24 * 60 * 60 * 1000)

# Server Configuration
SERVER_PORT=8081

# Hibernate Configuration
DDL_AUTO=update
# Options: validate | update | create | create-drop
# Production should use 'validate' only!
SHOW_SQL=false
# Set to 'false' in production

# ============================================
# SECURITY WARNINGS
# ============================================
# 1. NEVER use default passwords in production
# 2. JWT_SECRET_KEY must be at least 512 bits (64 bytes)
# 3. Rotate JWT_SECRET_KEY periodically
# 4. Use environment variables, not hardcoded values
# 5. Set DDL_AUTO=validate in production
# ============================================
